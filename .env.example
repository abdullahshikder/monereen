# Database
DATABASE_URL=postgres://monereen:replace-with-generated-database-password@localhost:5432/monereen

# Redis
REDIS_URL=redis://localhost:6379

# Medusa
JWT_SECRET=change-this-in-production
COOKIE_SECRET=change-this-in-production
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# Storefront
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# MinIO (local dev storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=monereen-storage
MINIO_SECRET_KEY=replace-with-generated-storage-password
MINIO_BUCKET=monereen-media
MINIO_FILE_URL=http://localhost:9002/monereen-media

# Payment (configure per provider)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Compose initialization (replace placeholders before starting services)
POSTGRES_PASSWORD=replace-with-generated-database-password
DOCKER_DATABASE_URL=postgres://monereen:replace-with-generated-database-password@postgres:5432/monereen
MINIO_ROOT_USER=monereen-storage
MINIO_ROOT_PASSWORD=replace-with-generated-storage-password

# Optional admin MFA enforcement; configure both only after creating Access.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=your-application-audience

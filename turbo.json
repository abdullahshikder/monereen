{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".medusa/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "ADMIN_CORS",
        "AUTH_CORS",
        "COOKIE_SECRET",
        "DATABASE_URL",
        "DB_HOST",
        "DB_PASSWORD",
        "DB_PORT",
        "DB_TEMP_NAME",
        "DB_USERNAME",
        "DB_WAITINGROOM_DATABASE",
        "JWT_SECRET",
        "REDIS_URL",
        "SEED_DEMO_PRODUCTS",
        "STORE_CORS"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}

{
  "name": "@monereen/medusa",
  "version": "0.1.0",
  "private": true,
  "description": "Monereen commerce backend — Medusa v2",
  "scripts": {
    "build": "medusa build",
    "migration:run": "medusa db:migrate",
    "predeploy": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "cleanup:demo-products": "medusa exec ./src/scripts/remove-demo-products.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test": "NODE_OPTIONS=--experimental-vm-modules TEST_TYPE=integration:http SEED_DEMO_PRODUCTS=true PORT=19000 jest --runInBand",
    "typecheck": "DISABLE_MEDUSA_ADMIN=true medusa build",
    "clean": "rm -rf dist node_modules .medusa"
  },
  "dependencies": {
    "@measured/puck": "^0.17.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@monereen/page-builder": "workspace:*",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@ariakit/react": "^0.4.15",
    "@hookform/resolvers": "3.4.2",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "date-fns": "^3.6.0",
    "jest": "^29.7.0",
    "lodash.debounce": "^4.0.8",
    "match-sorter": "^6.3.4",
    "radix-ui": "1.1.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "7.49.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "zod": "4.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
